<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- WinForms is referenced only for System.Drawing (GDI+); all windows are raw Win32. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\PeekTemp.ico</ApplicationIcon>
    <AssemblyName>PeekTemp</AssemblyName>
    <RootNamespace>PeekTemp</RootNamespace>
    <Version>1.0.0</Version>
    <Product>PeekTemp</Product>
    <Description>CPU/GPU temperature and load widget for the Windows 11 taskbar</Description>
    <Copyright>ilumetric</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- DPI awareness is declared in app.manifest on purpose: there is no WinForms Application here. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

</Project>
